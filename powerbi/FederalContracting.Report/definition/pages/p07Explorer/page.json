{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "p07Explorer",
  "displayName": "Award explorer",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1440,
  "filterConfig": {
    "filters": [
      {
        "name": "dtRecipient",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimRecipient"
              }
            },
            "Property": "Recipient"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dtAgency",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimAgency"
              }
            },
            "Property": "Agency Short"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "explorerScope",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimActionSize"
              }
            },
            "Property": "Action Size Band"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "b",
              "Entity": "DimActionSize",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "b"
                          }
                        },
                        "Property": "Action Size Band"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "'$100M and above'"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "howCreated": "User"
      }
    ]
  },
  "pageBinding": {
    "name": "dtExplorer",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "dtRecipientParam",
        "boundFilter": "dtRecipient",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimRecipient"
              }
            },
            "Property": "Recipient"
          }
        }
      },
      {
        "name": "dtAgencyParam",
        "boundFilter": "dtAgency",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimAgency"
              }
            },
            "Property": "Agency Short"
          }
        }
      }
    ]
  },
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#0D0F12'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#0D0F12'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "displayArea": [
      {
        "properties": {
          "verticalAlignment": {
            "expr": {
              "Literal": {
                "Value": "'Top'"
              }
            }
          }
        }
      }
    ]
  }
}