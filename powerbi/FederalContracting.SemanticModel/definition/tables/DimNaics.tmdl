/// North American Industry Classification System codes present in FY2025 contract transactions.
table DimNaics
	lineageTag: e49aac29-42a7-4374-972a-0f0be608ec4c

	column NaicsKey
		dataType: int64
		isHidden
		isKey
		isAvailableInMdx: false
		lineageTag: 69e2bd25-f714-4224-b9ad-ec854970e9ef
		summarizeBy: none
		sourceColumn: NaicsKey

	column 'NAICS Code'
