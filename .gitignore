# ---------------------------------------------------------------------------
# Power BI Desktop — machine-specific and sensitive artefacts
# ---------------------------------------------------------------------------
# localSettings.json contains a DPAPI securityBindingsSignature bound to the
# Windows account that created it. It must never be published.
**/.pbi/localSettings.json
**/.pbi/editorSettings.json

# cache.abf is the materialised model data (hundreds of MB). Regenerate it by
# opening the PBIP and refreshing.
**/.pbi/cache.abf
**/.pbi/

# Desktop scratch and recovery files
*.pbix
*.pbit
**/TempSaves/
**/*.tmp
**/~$*

# ---------------------------------------------------------------------------
# Data — never committed
# ---------------------------------------------------------------------------
# Raw source archive (1.79 GB) is downloaded from USAspending.gov, not stored here.
01_Raw_Data/
raw/
*.zip
*.7z
*.gz
*.tar

# Curated Parquet star schema (~160 MB) is generated by pipeline/. See README.
data/
*.parquet
*.duckdb
*.duckdb.wal

# Intermediate staging and scratch
stage/
stage2/
tmp/
bench/
scratch/
*.csv
*.tsv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Logs, reports, local output
# ---------------------------------------------------------------------------
*.log
logs/
output/
exports/

# ---------------------------------------------------------------------------
# Secrets — defence in depth. Nothing of this kind exists in the project,
# these patterns exist so it can never be added by accident.
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets.json
credentials.json
appsettings.*.json
*token*
*secret*

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
